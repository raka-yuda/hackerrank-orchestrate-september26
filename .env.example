# Source this file from your shell after adding your own key. Do not commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MIN_INTERVAL_SECONDS=4.1
GEMINI_THINKING_LEVEL=low

# Leave these at zero for a free-tier run. Set current paid-tier rates only when used.
GEMINI_INPUT_USD_PER_MILLION=0
GEMINI_OUTPUT_USD_PER_MILLION=0

# OpenAI Responses API alternative. Keep only the provider you intend to use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_MIN_INTERVAL_SECONDS=1.0

# Standard list rates for the pinned model; override for another pricing contract.
OPENAI_INPUT_USD_PER_MILLION=0.40
OPENAI_OUTPUT_USD_PER_MILLION=1.60
